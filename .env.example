# Scrapy Standalone Crawler Configuration (No third-party API key required)
SCRAPY_DOWNLOAD_DELAY=0.5
SCRAPY_CONCURRENT_REQUESTS=4

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
ALERT_SENDER_EMAIL=your_email@gmail.com
ALERT_RECIPIENT_EMAIL=your_email@gmail.com
